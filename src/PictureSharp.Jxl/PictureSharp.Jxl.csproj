<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Jxl</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Jxl</PackageId>
    <Description>Pure C# JPEG XL plugin for PictureSharp. Version 0.5.1 detects and identifies JPEG XL files (raw codestream and container), decodes still lossy (VarDCT, XYB) and lossless (Modular) images, including recompressed JPEGs, patches and progressive files, and reads the ICC profile, EXIF and XMP (also Brotli-compressed); with ColorConversion = ToSrgb lossy images are rendered straight to sRGB; encoding is not implemented yet.</Description>
    <PackageTags>picturesharp;image;jxl;jpegxl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/picturesharp.jxl</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.5.1: ColorConversion = ToSrgb renders lossy (XYB) images straight to sRGB in floating point, as djxl --color_space=sRGB does, so wide-gamut photos are quantized once and no longer differ by several levels near the edge of sRGB; this also covers ICC profiles with lookup tables. Images without XYB are still converted by PictureSharp. No public API changes; no encoding or animation support.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" /></ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
