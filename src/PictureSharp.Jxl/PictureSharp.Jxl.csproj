<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Jxl</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Jxl</PackageId>
    <Description>Pure C# JPEG XL plugin for PictureSharp. Detects and identifies JPEG XL files (raw codestream and container), decodes still lossy (VarDCT, XYB) and lossless (Modular) images, including recompressed JPEGs, patches and progressive files, encodes images lossily (VarDCT with quality, distance and effort 1-9, about as small as cjxl, the default) or losslessly (8-bit or 16-bit Modular, about as small as cjxl -d 0 -e 7), losslessly transcodes sequential and progressive 8-bit JPEG with byte-exact original reconstruction, and reads, writes and edits the ICC profile, EXIF and XMP (also Brotli-compressed).</Description>
    <PackageTags>picturesharp;image;jxl;jpegxl</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/picturesharp.jxl</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.7.9: faster lossy (VarDCT) encoding: chroma-from-luma and AC strategy searches without hard-to-predict branches, 8-point DCT leaves without copy passes, encoding from the image buffer without a pixel copy, and a correctly rounded cube root for the XYB conversion (port of CORE-MATH cbrtf, MIT). 1 MP lossy encode about 1.2x faster at efforts 1, 3 and 7, 8-bit and 16-bit. Lossless encoding, decoding and JPEG transcoding are byte-identical to 0.7.8; some lossy files differ in a few bytes (same size and quality).</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" /></ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
